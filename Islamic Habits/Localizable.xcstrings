    "About مرآة" : {

    },
    "about.feedback.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل هناك شيء ناقص أو لا يعمل؟ ملاحظاتك تساعد على تحسين مرآة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something missing or not working? Your feedback helps make مرآة better."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีอะไรขาดหรือไม่ทำงาน? ข้อเสนอแนะของคุณช่วยพัฒนา มรآة ให้ดีขึ้น"
          }
        }
      }
