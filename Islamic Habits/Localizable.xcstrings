        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرآة learns when you usually log and sends a gentle reminder if you haven't logged yet. No noise — just a nudge at the right time."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มรآة เรียนรู้เวลาที่คุณมักบันทึก และส่งการแจ้งเตือนอ่อนโยนหากยังไม่ได้บันทึก ไม่รบกวน — แค่เตือนในเวลาที่เหมาะสม"
          }
        }
      }
    },
