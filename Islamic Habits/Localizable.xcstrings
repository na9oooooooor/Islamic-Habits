    "insight.advice.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «الدِّينُ النَّصِيحَةُ». — صحيح مسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Religion is sincere advice.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท่านนบี ﷺ กล่าวว่า: “ศาสนาคือการตักเตือนด้วยความจริงใจ” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.advice.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقديم النصيحة الصادقة علامةٌ على محبة الخير للناس."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giving sincere advice is a sign of loving الخير for others."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การให้คำตักเตือนอย่างจริงใจ เป็นสัญญาณของการรักความดีให้แก่ผู้อื่น"
          }
        }
      }
    },
    "insight.advice.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النصيحة بلطفٍ أقرب إلى القلوب وأبلغ في التأثير."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advice given gently is more likely to enter the heart."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การให้คำแนะนำอย่างอ่อนโยน จะเข้าถึงหัวใจได้ง่ายกว่า และมีผลมากกว่า"
          }
        }
      }
    },
    "insight.dhikr.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ﴾ — سورة الرعد\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Verily, in the remembrance of Allah do hearts find rest.” — Surah Ar‑Ra’d 13:28"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“แท้จริงด้วยการรำลึกถึงอัลลอฮ์ หัวใจจะสงบ” — ซูเราะฮ์อัรเราะอ์ด 13:28"
          }
        }
      }
    },
    "insight.dhikr.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «لَأَنْ أَقُولَ: سُبْحَانَ اللَّهِ، وَالْحَمْدُ لِلَّهِ، وَلَا إِلَهَ إِلَّا اللَّهُ، وَاللَّهُ أَكْبَرُ أَحَبُّ إِلَيَّ مِمَّا طَلَعَتْ عَلَيْهِ الشَّمْسُ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “SubhanAllah, Alhamdulillah, La ilaha illa Allah, and Allahu Akbar are more beloved than all the sun rises upon.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท่านนบี ﷺ กล่าวว่า: “ซุบฮานัลลอฮ์ อัลฮัมดุลิลลาห์ ลาอิลาฮะอิลลัลลอฮ์ และอัลลอฮุอักบัร เป็นสิ่งที่รักยิ่งกว่าสิ่งใดที่ดวงอาทิตย์ขึ้นเหนือมัน” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.dhikr.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذِكْرُ اللَّهِ يُكَفِّرُ الذُّنُوبَ وَيَرْفَعُ الدَّرَجَاتِ — صحيح البخاري\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dhikr wipes away sins and raises ranks. — Sahih al‑Bukhari"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซิกรุลลอฮ์ลบล้างบาปและยกระดับขั้น — เศาะฮีห์อัลบุคอรี"
          }
        }
      }
    },
    "insight.duaa.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿ادْعُونِي أَسْتَجِبْ لَكُمْ﴾ — سورة غافر \n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Call upon Me; I will respond to you.” — Surah Ghafir 40:60"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“จงวิงวอนต่อข้า แล้วข้าจะตอบรับพวกเจ้า” — ซูเราะฮ์ฆอฟิร "
          }
        }
      }
    },
    "insight.duaa.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «الدُّعَاءُ هُوَ الْعِبَادَةُ». — جامع الترمذي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Dua is worship.” — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การดุอาคือการอิบาดะฮ์” — ญามิอ์ อัต-ติรมิซีย์"
          }
        }
      }
    },
    "insight.duaa.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مَا مِنْ دُعَاءٍ صَادِقٍ إِلَّا وَيُجِيبُ اللَّهُ بِهِ بِإِحْدَى ثَلَاثٍ — مسند أحمد\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No sincere dua is ever lost; Allah answers, delays, or replaces it with something better. — Musnad Ahmad"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ไม่มีดุอาอ์ที่จริงใจใดสูญเปล่า อัลลอฮ์จะตอบรับในหนึ่งในสามรูปแบบ” — มุสนัดอะหมัด"
          }
        }
      }
    },
    "insight.fasting.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «الصِّيَامُ جُنَّةٌ». — صحيح البخاري\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Fasting is a shield.” — Sahih al‑Bukhari"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การถือศีลอดคือโล่ป้องกัน” — เศาะฮีห์อัลบุคอรี"
          }
        }
      }
    },
    "insight.fasting.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال الله تعالى: «الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allah says: “Fasting is for Me, and I will reward it.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การถือศีลอดเป็นของข้า และข้าจะเป็นผู้ตอบแทนมัน” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.fasting.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصِّيَامُ يُهَذِّبُ الشَّهَوَاتِ وَيُلَيِّنُ الْقَلْبَ لِلَّهِ\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fasting disciplines desires and softens the heart toward Allah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การถือศีลอดช่วยขัดเกลากิเลสและทำให้หัวใจอ่อนน้อมต่ออัลลอฮ์”"
          }
        }
      }
    },
    "insight.feeding.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «أَطْعِمُوا الطَّعَامَ». — صحيح البخاري"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Feed the hungry.” — Sahih al‑Bukhari"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“จงให้อาหารแก่ผู้หิวโหย” — เศาะฮีห์อัลบุคอรี"
          }
        }
      }
    },
    "insight.feeding.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «خَيْرُكُمْ مَنْ أَطْعَمَ الطَّعَامَ» - رواه احمد"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: \"The best of you are those who feed others.\" — Narrated by Ahmad"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ท่านนบี ﷺ กล่าวว่า: \"ผู้ที่ดีเลิศที่สุดในหมู่พวกท่าน คือผู้ที่ให้อาหาร (แก่ผู้อื่น)\" — บันทึกโดยอะห์หมัด"
          }
        }
      }
    },
    "insight.feeding.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ» — رواه البخاري ومسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: Guard yourselves against the Fire even if with half a date (in charity).” — Sahih al-Bukhari & Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: จงปกป้องตัวเองจากไฟนรก แม้เพียงการบริจาคแค่ครึ่งผลอินทผลัม” — เศาะฮีห์อัลบุคอรี และเศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.good_word.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ — صحيح البخاري"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “A good word is charity.” — Sahih al‑Bukhari"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“คำพูดที่ดีคือการบริจาคทาน” — เศาะฮีห์อัลบุคอรี"
          }
        }
      }
    },
    "insight.good_word.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«مَنْ كَانَ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الآخِرِ فَلْيَقُلْ خَيْرًا أَوْ لِيَصْمُتْ» — رواه البخاري ومسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Whoever believes in Allah and the Last Day should speak what is good or keep silent.\" — Sahih al-Bukhari & Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"ผู้ใดที่ศรัทธาต่ออัลลอฮ์และวันปรโลก จงพูดแต่สิ่งที่ดีหรือไม่ก็จงนิ่งเสีย\" — บันทึกโดยอัล-บุคอรีย์ และมุสลิม"
          }
        }
      }
    },
    "insight.good_word.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«اتَّقُوا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ، فَمَنْ لَمْ يَجِدْ فَبِكَلِمَةٍ طَيِّبَةٍ» — رواه البخاري ومسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Guard yourselves against the Fire even with half a date (given in charity), and if you cannot find that, then with a kind word.\" — Sahih al-Bukhari & Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"พวกท่านจงปกป้องตนเองให้พ้นจากไฟนรก แม้ด้วยกับอินทผลัมเพียงครึ่งซีก (ที่บริจาคทาน) และหากใครที่ไม่พบสิ่งใด (จะบริจาค) ก็ด้วยกับคำพูดที่ดี\" — บันทึกโดยอัล-บุคอรีย์ และมุสลิม"
          }
        }
      }
    },
    "insight.hadith.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «بَلِّغُوا عَنِّي وَلَوْ آيَةً». — صحيح البخاري\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: Convey from me even one verse.” — Sahih al-Bukhari\n"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ท่านนบีกล่าวว่า: จงถ่ายทอดจากฉันแม้เพียงหนึ่งอายะฮ์” — เศาะฮีห์อัลบุคอรี"
          }
        }
      }
    },
    "insight.hadith.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «نَضَّرَ اللَّهُ امْرَأً سَمِعَ مَقَالَتِي فَبَلَّغَهَا». — الترمذي\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “May Allah brighten a person who hears my words and conveys them.” — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ขออัลลอฮ์ทรงให้ความสดใสแก่ผู้ที่ได้ยินคำพูดของฉันแล้วถ่ายทอดต่อ” — อัต-ติรมิซีย์"
          }
        }
      }
    },
    "insight.hadith.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ». — صحيح مسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: Whoever travels a path seeking knowledge, Allah will make a path to Paradise easy for him.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: ผู้ใดเดินบนเส้นทางแห่งการแสวงหาความรู้ อัลลอฮ์จะทำให้เส้นทางไปสู่สวรรค์ง่ายแก่เขา” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.islamic_study.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " قال النبي ﷺ: «مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ طَرِيقًا إِلَى الْجَنَّةِ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Whoever follows a path seeking knowledge, Allah will make a path to Paradise easy for him.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ผู้ใดแสวงหาความรู้ อัลลอฮ์จะทำให้ทางสู่สวรรค์ง่ายแก่เขา” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.islamic_study.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «مَنْ تَعَلَّمَ عِلْمًا مِمَّا يُبْتَغَى بِهِ وَجْهُ اللَّهِ تَعَالَى لَا يَتَعَلَّمُهُ إِلَّا لِيُصِيبَ بِهِ عَرَضًا مِنَ الدُّنْيَا لَمْ يَجِدْ عَرْفَ الْجَنَّةِ يَوْمَ الْقِيَامَةِ». — رواه أبو داود"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: Whoever learns knowledge by which the Face of Allah is sought, but only learns it for worldly gain, will not even smell the fragrance of Paradise on the Day of Judgment.” — Reported by Abu Dawud"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: ผู้ใดเรียนความรู้ที่ควรใช้เพื่อแสวงหาความพอพระทัยของอัลลอฮ์ แต่กลับเรียนเพื่อผลประโยชน์ทางโลก เขาจะไม่ได้แม้แต่กลิ่นหอมของสวรรค์ในวันกิยามะฮ์” — รายงานโดยอบูดาวูด"
          }
        }
      }
    },
    "insight.islamic_study.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخْفِضُ الْمَلَائِكَةُ أَجْنِحَتَهَا لِطَالِبِ الْعِلْمِ — الترمذي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The angels lower their wings for the seeker of knowledge. — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“บรรดามลาอิกะฮ์จะกางปีกให้แก่ผู้แสวงหาความรู้” — อัต-ติรมิซีย์"
          }
        }
      }
    },
    "insight.masjid.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿إِنَّمَا يَعْمُرُ مَسَاجِدَ اللَّهِ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ﴾ — التوبة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The mosques of Allah are maintained by those who believe in Allah and the Last Day.” — Surah At‑Tawbah 9:18"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“แท้จริงผู้ที่ดูแลมัสยิดของอัลลอฮ์คือผู้ศรัทธาต่ออัลลอฮ์และวันอาคิเราะฮ์” — ซูเราะฮ์อัตเตาบะฮ์"
          }
        }
      }
    },
    "insight.masjid.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «مَا مِنْ مُسْلِمٍ يَمْشِي إِلَى الصَّلَاةِ إِلَّا رُفِعَتْ لَهُ دَرَجَةٌ وَحُطَّتْ عَنْهُ خَطِيئَةٌ». — صحيح مسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every step to the masjid raises a rank and removes a sin. — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ทุกย่างก้าวไปละหมาดจะถูกยกระดับขั้นและลบล้างบาป” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.masjid.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال الله تعالى: ﴿فِي بُيُوتٍ أَذِنَ اللَّهُ أَنْ تُرْفَعَ وَيُذْكَرَ فِيهَا اسْمُهُ يُسَبِّحُ لَهُ فِيهَا بِالْغُدُوِّ وَالْآصَالِ * رِجَالٌ لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ وَإِقَامِ الصَّلَاةِ...﴾ — سورة النور "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Allah says: In houses which Allah has permitted to be raised and His name to be mentioned in them, there glorify Him therein morning and evening * Men whom neither trade nor sale distracts from the remembrance of Allah and establishing prayer…” - Surah An-Nur"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัลลอฮ์ตรัสว่า: “ในบรรดาบ้านทั้งหลายที่อัลลอฮ์ทรงอนุญาตให้ยกย่อง และให้พระนามของพระองค์ถูกกล่าวถึงในนั้น จะมีผู้ที่สดุดีพระองค์ทั้งยามเช้าและยามเย็น * คือบรรดาผู้ชายที่การค้าหรือการขายไม่ทำให้พวกเขาละเลยจากการรำลึกถึงอัลลอฮ์และการดำรงละหมาด…” — ซูเราะฮ์อันนูร "
          }
        }
      }
    },
    "insight.qiyam.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «أَفْضَلُ الصَّلَاةِ بَعْدَ الْفَرِيضَةِ صَلَاةُ اللَّيْلِ». — صحيح مسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “The best prayer after the obligatory prayers is the night prayer.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การละหมาดที่ดีที่สุดหลังฟัรฎู คือการละหมาดกลางคืน” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.qiyam.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿وَالَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّدًا وَقِيَامًا﴾ — سورة الفرقان"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“And those who spend the night prostrating and standing for their Lord.” - Surah Al-Furqan "
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“และบรรดาผู้ที่ใช้เวลายามค่ำคืนในการสุญูดและยืนละหมาดเพื่อพระเจ้าของพวกเขา” — ซูเราะฮ์อัลฟุรกอน"
          }
        }
      }
    },
    "insight.qiyam.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿كَانُوا قَلِيلًا مِنَ اللَّيْلِ مَا يَهْجَعُونَ﴾ — السجدة\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Those who pray at night are praised in the Qur’an. — Surah As‑Sajdah 32:16"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ที่ละหมาดในยามค่ำคืนได้รับการยกย่องในคัมภีร์อัลกุรอาน — ซูเราะฮ์อัสสะญดะฮ์ 32:16"
          }
        }
      }
    },
    "insight.quran.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿إِنَّ هَٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ﴾ — الإسراء \n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Indeed, this Qur’an guides to that which is most upright.” — Surah Al‑Isra 17:9"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“แท้จริงอัลกุรอานนี้ชี้นำสู่ทางที่เที่ยงตรงที่สุด” — ซูเราะฮ์อัลอิสรออ์"
