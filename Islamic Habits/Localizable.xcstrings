          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «أَفْضَلُ الصَّدَقَةِ سَقْيُ الْمَاءِ». — حسن / روايات متعددة\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “The best charity is giving water to drink.” — Sunan Abu Dawud"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การบริจาคที่ดีที่สุดคือการให้น้ำ” — ความหมายจากหะดีษ"
          }
        }
      }
    },
    "insight.water.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «أَيُّمَا مُسْلِمٍ سَقَى مُسْلِمًا عَلَى ظَمَإٍ سَقَاهُ اللَّهُ مِنَ الرَّحِيقِ الْمَخْتُومِ». — رواه أبو داود"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: Whoever gives drink to a thirsty Muslim, Allah will give him to drink from the sealed nectar (of Paradise).” — Sunan Abu Dawud"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: ผู้ใดให้น้ำดื่มแก่พี่น้องมุสลิมที่กระหายน้ำ อัลลอฮ์จะทรงให้เขาได้ดื่มจากสุราสวรรค์ที่ถูกปิดผนึกไว้” — สุนัน อบูดาวูด"
          }
        }
      }
    },
    "insight.water.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سَقَى رَجُلٌ كَلْبًا فَغَفَرَ اللَّهُ لَهُ — صحيح البخاري"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A man was forgiven by Allah for giving water to a thirsty dog. — Sahih al‑Bukhari"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ชายคนหนึ่งให้น้ำสุนัข แล้วอัลลอฮ์ทรงอภัยโทษให้เขา” — เศาะฮีห์อัลบุคอรี"
