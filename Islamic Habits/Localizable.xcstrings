{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "\"The most beloved deeds to Allah are the most consistent, even if small.\"" : {
      "comment" : "A quote from the Quran that emphasizes the importance of consistent, even small, actions.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«أحبُّ الأعمال إلى الله أدومُها وإن قلَّت.»"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การงานที่อัลลอฮ์ทรงรักมากที่สุด คือการงานที่ทำอย่างสม่ำเสมอ แม้จะเล็กน้อยก็ตาม"
          }
        }
      }
    },
    "%@ %lld" : {
      "comment" : "A badge displaying the current level of a focus deed. The text inside the badge is formatted to include the word \"level\" in the selected language.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld"
          }
        }
      }
    },
    "%@ %lld  ·  %lld %@ %@" : {
      "comment" : "A badge displaying the current habit level and the goal for the day. The first argument is the current habit level. The second argument is the goal for the day.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld  ·  %3$lld %4$@ %5$@"
          }
        }
      }
    },
