      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بِكُلِّ حَرْفٍ مِنَ الْقُرْآنِ حَسَنَةٌ وَالْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا — الترمذي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reading one letter of the Qur’an brings ten rewards. — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การอ่านอัลกุรอานหนึ่งตัวอักษรได้รับผลบุญสิบเท่า — ญามิอ์ อัตติรมิซี"
          }
        }
      }
    },
    "insight.remove_harm.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «إِمَاطَةُ الأَذَى عَنِ الطَّرِيقِ صَدَقَةٌ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Removing harmful things from the road is charity.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การเอาสิ่งอันตรายออกจากทางคือการบริจาคทาน” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.remove_harm.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «الإِيمَانُ بِضْعٌ وَسِتُّونَ شُعْبَةً... وَإِمَاطَةُ الأَذَى عَنِ الطَّرِيقِ مِنْهَا». — صحيح مسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Faith has branches… and removing harm is one of them.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“อีมานมีหลายแขนง… และการเอาสิ่งอันตรายออกจากทางเป็นหนึ่งในนั้น” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.remove_harm.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عن أبي هريرة رضي الله عنه أن رسول الله ﷺ قال: «بَيْنَمَا رَجُلٌ يَمْشِي بِطَرِيقٍ، وَجَدَ غُصْنَ شَوْكٍ فَأَخَذَهُ، فَشَكَرَ اللَّهُ لَهُ فَغَفَرَ لَهُ». — رواه البخاري ومسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: While a man was walking on a road, he found a thorny branch and removed it, so Allah appreciated his deed and forgave him.” — Sahih al-Bukhari & Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: ขณะที่ชายคนหนึ่งกำลังเดินอยู่บนทาง เขาพบกิ่งไม้หนามจึงนำมันออกไป แล้วอัลลอฮ์ทรงขอบคุณการกระทำนั้นและทรงอภัยโทษให้เขา” — เศาะฮีห์อัลบุคอรี และเศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.sadaqah.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصَّدَقَةُ لَا تَنْقُصُ الْمَالَ — صحيح مسلم"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Charity does not decrease wealth.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การบริจาคไม่ทำให้ทรัพย์ลดลง” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.sadaqah.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «إِنَّ الصَّدَقَةَ تُطْفِئُ الْخَطِيئَةَ كَمَا يُطْفِئُ الْمَاءُ النَّارَ». — جامع الترمذي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadaqah extinguishes sins like water extinguishes fire. — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: การบริจาคทานจะดับบาปเหมือนน้ำดับไฟ” — ญามิอ์ อัต-ติรมิซีย์"
          }
        }
      }
    },
    "insight.sadaqah.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال الله تعالى: ﴿مَثَلُ الَّذِينَ يُنفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنبُلَةٍ مِائَةُ حَبَّةٍ ۗ وَاللَّهُ يُضَاعِفُ لِمَن يَشَاءُ﴾ — سورة البقرة"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Allah says: The example of those who spend their wealth in the way of Allah is like a seed which grows seven ears; in every ear is a hundred grains, and Allah multiplies for whom He wills.” — Surah Al-Baqarah"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“อัลลอฮ์ตรัสว่า: อุปมาแก่ผู้ที่บริจาคทรัพย์ของพวกเขาในหนทางของอัลลอฮ์ เปรียบเหมือนเมล็ดพืชหนึ่งเมล็ดที่งอกออกมาเป็นเจ็ดรวง และในแต่ละรวงมีหนึ่งร้อยเมล็ด และอัลลอฮ์จะเพิ่มพูนให้แก่ผู้ที่พระองค์ทรงประสงค์” — ซูเราะฮ์อัลบะเกาะเราะฮ์"
          }
        }
      }
    },
    "insight.smile.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ صَدَقَةٌ». — الترمذي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Your smile for your brother is charity.” — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“การยิ้มให้พี่น้องของเจ้าคือการบริจาคทาน” — อัต-ติรมิซีย์"
          }
        }
      }
    },
    "insight.smile.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عن جرير بن عبد الله رضي الله عنه قال: «مَا حَجَبَنِي النَّبِيُّ ﷺ مُنْذُ أَسْلَمْتُ، وَلَا رَآنِي إِلَّا تَبَسَّمَ فِي وَجْهِي». — متفق عليه"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ never prevented me from seeing him since I embraced Islam, and whenever he saw me, he would smile in my face.” — Agreed upon (Al-Bukhari & Muslim)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“ท่านนบี ﷺ ไม่เคยปฏิเสธไม่ให้ฉันพบท่านตั้งแต่ฉันรับอิสลาม และเมื่อใดที่ท่านเห็นฉัน ท่านจะยิ้มให้ฉันเสมอ” — รายงานโดยเศาะฮีห์อัลบุคอรี และเศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.smile.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «لَا تَحْقِرَنَّ مِنَ الْمَعْرُوفِ شَيْئًا وَلَوْ أَنْ تَلْقَى أَخَاكَ بِوَجْهٍ طَلْقٍ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Do not belittle any good deed, even meeting your brother with a cheerful face.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“อย่าดูถูกความดีแม้เพียงการพบพี่น้องด้วยใบหน้าที่ยิ้มแย้ม” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.sunnah.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «مَنْ أَحْيَا سُنَّتِي فَقَدْ أَحَبَّنِي». — الترمذي\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Whoever revives my Sunnah has loved me.” — Jamiʿ at‑Tirmidhi"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ผู้ที่ฟื้นฟูซุนนะฮ์ของฉัน เขาได้รักฉันแล้ว” — อัต-ติรมิซีย์"
          }
        }
      }
    },
    "insight.sunnah.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال الله تعالى: ﴿قُلْ إِن كُنتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ﴾ — سورة آل عمران"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Allah says: Say, ‘If you love Allah, then follow me; Allah will love you and forgive you your sins.’” — Surah Aal ‘Imran"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“อัลลอฮ์ตรัสว่า: จงกล่าวเถิด (มุฮัมมัด) หากพวกเจ้ารักอัลลอฮ์ ก็จงปฏิบัติตามฉัน แล้วอัลลอฮ์จะทรงรักพวกเจ้าและทรงอภัยโทษบาปของพวกเจ้า” — ซูเราะฮ์อาลอิมรอน"
          }
        }
      }
    },
    "insight.sunnah.3" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إِنَّ أَحَبَّ الأَعْمَالِ إِلَى اللَّهِ أَدْوَمُهَا وَإِنْ قَلَّ — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Small Sunnah acts done consistently are beloved to Allah. — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำซุนนะฮ์เล็ก ๆ หากผู้ศรัทธาทำอย่างสม่ำเสมอ จะเป็นสิ่งที่อัลลอฮ์ทรงรักยิ่ง — รายงานโดยเศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.sunnahSalat.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «مَا مِنْ عَبْدٍ يُصَلِّي لِلَّهِ ثِنْتَيْ عَشْرَةَ رَكْعَةً تَطَوُّعًا إِلَّا بَنَى اللَّهُ لَهُ بَيْتًا فِي الْجَنَّةِ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Whoever prays 12 voluntary rak‘ahs, Allah builds for him a house in Paradise.” — Sahih Muslim\n"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ผู้ใดละหมาดสุนัต 12 ร็อกอะฮ์ อัลลอฮ์จะสร้างบ้านในสวรรค์ให้เขา” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.sunnahSalat.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «رَكْعَتَا الْفَجْرِ خَيْرٌ مِنَ الدُّنْيَا وَمَا فِيهَا». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Two rak‘ahs of Fajr sunnah are better than the world and what it contains.” — Sahih Muslim\n"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“สุนัตก่อนฟัจญร์ 2 ร็อกอะฮ์ ดีกว่าโลกทั้งใบและสิ่งที่อยู่ในนั้น” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.sunnahSalat.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «اجْعَلُوا مِنْ صَلَاتِكُمْ فِي بُيُوتِكُمْ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Make part of your prayers in your homes.” — Sahih Muslim\n"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“จงทำการละหมาดบางส่วนในบ้านของพวกเจ้า” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.visit_sick.1" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال النبي ﷺ: «مَا مِنْ مُسْلِمٍ يَعُودُ مَرِيضًا إِلَّا كَانَ فِي خُرْفَةِ الْجَنَّةِ». — صحيح مسلم\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Prophet ﷺ said: “Whoever visits the sick remains in the gardens of Paradise until he returns.” — Sahih Muslim"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ไม่มีมุสลิมคนใดไปเยี่ยมผู้ป่วย إلاจะอยู่ในสวนแห่งสวรรค์” — เศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.visit_sick.2" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قال النبي ﷺ: «حَقُّ الْمُسْلِمِ عَلَى الْمُسْلِمِ خَمْسٌ…» وذكر منها: «وَعِيَادَةُ الْمَرِيضِ». — متفق عليه"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“The Prophet ﷺ said: The rights of a Muslim over another Muslim are five… and among them is visiting the sick.” — Agreed upon (Al-Bukhari & Muslim)"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ท่านนบี ﷺ กล่าวว่า: สิทธิของมุสลิมที่มีต่อมุสลิมอีกคนมีห้าประการ… และหนึ่งในนั้นคือการเยี่ยมผู้ป่วย” — รายงานโดยเศาะฮีห์อัลบุคอรี และเศาะฮีห์มุสลิม"
          }
        }
      }
    },
    "insight.visit_sick.3" : {
