    "about.privacy.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما تسجّله يبقى على جهازك. لا حسابات. لا تتبع. لا بيانات تغادر هاتفك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything you log stays on your device. No accounts. No tracking. No data leaves your phone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกสิ่งที่บันทึกอยู่บนอุปกรณ์ของคุณ ไม่มีบัญชี ไม่มีการติดตาม ไม่มีข้อมูลออกจากโทรศัพท์"
          }
        }
      }
    },
    "about.privacy.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخصوصية"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRIVACY"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความเป็นส่วนตัว"
          }
        }
      }
    },
    "about.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرآة هو مرآة لروحك. يساعدك على بناء عادات إسلامية من خلال الاتساق والتأمل وعلم تكوين العادات. الأعمال الصغيرة المستمرة أحب إلى الله من الأعمال الكبيرة النادرة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرآة is a mirror for your soul. It helps you build Islamic habits through consistency, reflection, and the science of habit formation. Small deeds done consistently are more beloved to Allah than great deeds done rarely."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มรآة คือกระจกส่องวิญญาณของคุณ ช่วยสร้างนิสัยอิสลามผ่านความสม่ำเสมอ การไตร่ตรอง และวิทยาศาสตร์การสร้างนิสัย ความดีเล็กน้อยที่ทำสม่ำเสมอเป็นที่รักของอัลลอฮ์มากกว่าความดีใหญ่ที่ทำนานๆ ครั้ง"
          }
        }
      }
    },
    "about.title" : {
      "extractionState" : "manual",
      "localizations" : {
